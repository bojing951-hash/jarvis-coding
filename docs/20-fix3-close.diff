diff --git a/orchestrator/test/fix3-close.test.mjs b/orchestrator/test/fix3-close.test.mjs
new file mode 100644
index 0000000..03f8803
--- /dev/null
+++ b/orchestrator/test/fix3-close.test.mjs
@@ -0,0 +1,418 @@
+/**
+ * FIX3-CLOSE 预审缺陷回归（PRE-A01 / PRE-A02 / PRE-A03）。
+ *
+ * 这些测试使用真实的 SQLite、git、审批挑战与签名，只把 Docker/Claude Code
+ * 替换为受控隔离替身，以便在无模型调用的情况下跑完整合法执行链。
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { generateKeyPairSync, createSign } from 'node:crypto';
+
+const tmp = mkdtempSync(join(tmpdir(), 'jarvis-close-'));
+process.env.HOME = tmp;
+process.env.JARVIS_HOME = join(tmp, 'jarvis');
+process.env.JARVIS_DB = join(tmp, 'state.db');
+mkdirSync(join(tmp, '.openclaw/jarvis/auth'), { recursive: true });
+mkdirSync(join(tmp, '.claude'), { recursive: true });
+writeFileSync(join(tmp, '.claude/settings.json'), JSON.stringify({ env: { ANTHROPIC_MODEL: 'test-model' } }));
+
+const { privateKey, publicKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+writeFileSync(join(tmp, '.openclaw/jarvis/auth/pubkey.der'), publicKey.export({ type: 'spki', format: 'der' }));
+
+const svc = await import('../src/service.mjs');
+const sec = await import('../src/security.mjs');
+const ex = await import('../src/executor.mjs');
+
+const gitRepo = (dir) => {
+  mkdirSync(dir, { recursive: true });
+  const g = (...a) => execFileSync('git', ['-C', dir, ...a], { encoding: 'utf8' });
+  g('init', '-q');
+  writeFileSync(join(dir, 'a.txt'), 'x\n');
+  g('add', '-A');
+  g('-c', 'user.name=t', '-c', 'user.email=t@t', 'commit', '-q', '-m', 'init');
+  return g('rev-parse', 'HEAD').trim();
+};
+
+const fakeIsolation = {
+  isolationStatus: async () => ({ available: true, backend: 'fake', image: 'fake-image', network: 'fake-net', networkInternal: true }),
+  egressProxyUrl: async () => 'http://127.0.0.1:9',
+  runClaudeIsolated: async ({ workdir }) => {
+    writeFileSync(join(workdir, 'feature.txt'), 'generated by fake executor\n');
+    return { ok: true, exitCode: 0, text: 'done', isolated: true, network: 'fake-net', image: 'fake-image', raw: '' };
+  },
+  runInWorkdir: async () => ({ ok: true, exitCode: 0, output: 'verify ok' }),
+  killContainer: async (name) => ({ ok: true, confirmed: true, name })
+};
+
+function projectWithRepo(label) {
+  const p = svc.createProject({ name: label, slug: `${label}-${Date.now().toString(36)}` });
+  const head = gitRepo(join(p.dir, 'repo'));
+  return { p, head };
+}
+
+function seedVerifyProfile(project, { program = process.execPath, argv = [] } = {}) {
+  const id = `vpr_${Math.random().toString(36).slice(2, 10)}`;
+  svc.db()
+    .prepare('INSERT INTO verify_profiles (id,project_id,name,program,argv,cwd,timeout_ms,created_by,created_at) VALUES (?,?,?,?,?,?,?,?,?)')
+    .run(id, project.id, `verify-${id}`, program, JSON.stringify(argv), null, 300_000, 'test', new Date().toISOString());
+  return id;
+}
+
+function seedTask({ project, head, verifyProfileId, mode = 'acceptEdits', commit = true, commitPaths = ['feature.txt'] }) {
+  return svc.createTask({
+    project: project.id,
+    title: '合法写入任务',
+    input: 'write feature.txt',
+    kind: 'executor',
+    executor: 'claude-code',
+    executorConfig: {
+      mode,
+      repo: 'repo',
+      base_commit: head,
+      commit,
+      commit_paths: commitPaths,
+      verify_profile_id: verifyProfileId
+    }
+  });
+}
+
+function signChallenge(challenge) {
+  const signer = createSign('sha256');
+  signer.update(challenge.payload);
+  return {
+    nonce: challenge.nonce,
+    payload: challenge.payload,
+    signatureB64: signer.sign(privateKey).toString('base64')
+  };
+}
+
+/* ------------------------------- PRE-A01 --------------------------------- */
+
+test('PRE-A01 同一 Execution 消耗审批后仍可完成合法提交', async () => {
+  const { p, head } = projectWithRepo('a01');
+  const vp = seedVerifyProfile(p);
+  const t = seedTask({ project: p, head, verifyProfileId: vp });
+  const challenge = svc.createAuthChallenge(t.id);
+  const proof = signChallenge(challenge);
+  const issued = svc.issueApproval({ task: t.id, proof });
+  assert.equal(issued.ok, true, JSON.stringify(issued));
+
+  const r = await svc.runTask(t.id, { isolation: fakeIsolation });
+  assert.equal(
+    r.ok,
+    true,
+    JSON.stringify({ blocked: r.blocked, commit: r.commit, verdict: r.verdict, task: svc.getTask(t.id).status })
+  );
+  const done = svc.getTask(t.id);
+  assert.equal(done.status, 'done');
+  assert.ok(r.commit?.sha, '必须记录真实 commit SHA');
+  assert.equal(r.commit.refVerified, true, '必须能从 ref 取回同一 SHA');
+  assert.equal(r.task.status, 'done');
+
+  const approval = svc.db().prepare('SELECT * FROM approvals WHERE task_id=?').get(t.id);
+  assert.ok(approval.used_at, '审批必须已消耗');
+  assert.equal(approval.execution_id, r.execution, '审批必须记录取得它的 Execution');
+  assert.equal(svc.findValidApproval(t.id, approval.digest).valid, false, '已消耗审批不得再给新执行使用');
+  const tokenFile = join(process.env.JARVIS_HOME, 'proxy', 'active-tokens.json');
+  assert.deepEqual(JSON.parse(readFileSync(tokenFile, 'utf8')), {}, '执行结束后模型令牌必须撤销');
+});
+
+/* ------------------------------- PRE-A02 --------------------------------- */
+
+test('PRE-A02 直接调用 issueApproval 无签名证明必须拒绝', () => {
+  const { p, head } = projectWithRepo('a02');
+  const vp = seedVerifyProfile(p);
+  const t = seedTask({ project: p, head, verifyProfileId: vp });
+  const before = svc.db().prepare('SELECT COUNT(*) AS n FROM approvals WHERE task_id=?').get(t.id).n;
+
+  const noProof = svc.issueApproval({ task: t.id, auth: null });
+  assert.equal(noProof.ok, false, 'auth=null 不得签发审批');
+
+  const forged = svc.issueApproval({
+    task: t.id,
+    proof: { nonce: 'forged', payload: Buffer.from('{"task_id":"x"}'), signatureB64: 'ZmFrZQ==' }
+  });
+  assert.equal(forged.ok, false, '伪造证明不得签发审批');
+
+  const after = svc.db().prepare('SELECT COUNT(*) AS n FROM approvals WHERE task_id=?').get(t.id).n;
+  assert.equal(after, before, '失败签发不得写入审批');
+});
+
+test('PRE-A02 直接登记可信校验配置无签名证明必须拒绝', () => {
+  const { p } = projectWithRepo('a02b');
+  assert.throws(
+    () => svc.createVerifyProfile({ project: p.id, name: 'no-proof', program: process.execPath, argv: [] }),
+    /签名|授权|证明|proof/
+  );
+});
+
+/* ------------------------------- PRE-A03 --------------------------------- */
+
+test('PRE-A03 签名后修改任务参数必须拒绝签发', () => {
+  const { p, head } = projectWithRepo('a03');
+  const vp = seedVerifyProfile(p);
+  const t = seedTask({ project: p, head, verifyProfileId: vp, mode: 'plan', commit: false });
+  const challenge = svc.createAuthChallenge(t.id);
+  const proof = signChallenge(challenge);
+
+  // 认证过程中修改会影响授权范围的参数
+  svc.updateTask(t.id, {
+    executor_config: JSON.stringify({ mode: 'acceptEdits', repo: 'repo', base_commit: head, commit: true, commit_paths: ['feature.txt'], verify_profile_id: vp })
+  });
+
+  const r = svc.issueApproval({ task: t.id, proof });
+  assert.equal(r.ok, false, '签名载荷与任务当前参数不一致时必须拒绝');
+  const n = svc.db().prepare('SELECT COUNT(*) AS n FROM approvals WHERE task_id=?').get(t.id).n;
+  assert.equal(n, 0, '不得写入审批');
+});
+
+test('PRE-A03 校验配置内容变化必须使原审批失效', () => {
+  const { p, head } = projectWithRepo('a03b');
+  const vp = seedVerifyProfile(p, { argv: [] });
+  const t = seedTask({ project: p, head, verifyProfileId: vp });
+  const challenge = svc.createAuthChallenge(t.id);
+  const proof = signChallenge(challenge);
+
+  svc.db().prepare('UPDATE verify_profiles SET argv=? WHERE id=?').run(JSON.stringify(['-e', 'process.exit(0)']), vp);
+
+  const r = svc.issueApproval({ task: t.id, proof });
+  assert.equal(r.ok, false, '校验配置内容变化后，原签名不得继续签发');
+  assert.equal(svc.db().prepare('SELECT COUNT(*) AS n FROM approvals WHERE task_id=?').get(t.id).n, 0);
+});
+
+
+const headOf = (repo) => execFileSync('git', ['-C', repo, 'rev-parse', 'HEAD'], { encoding: 'utf8' }).trim();
+
+function approvedTask(label, overrides = {}) {
+  const { p, head } = projectWithRepo(label);
+  const vp = seedVerifyProfile(p);
+  const t = seedTask({ project: p, head, verifyProfileId: vp, ...overrides });
+  const challenge = svc.createAuthChallenge(t.id);
+  const issued = svc.issueApproval({ task: t.id, proof: signChallenge(challenge) });
+  assert.equal(issued.ok, true, issued.error);
+  return { p, t, repo: join(p.dir, 'repo') };
+}
+
+/* -------------------- PRE-A01：提交阶段复核/不可复用 -------------------- */
+
+test('PRE-A01 提交前任务参数漂移必须拒绝提交', async () => {
+  const { t, repo } = approvedTask('a01-drift');
+  const before = headOf(repo);
+  const driftIso = {
+    ...fakeIsolation,
+    runClaudeIsolated: async ({ workdir }) => {
+      writeFileSync(join(workdir, 'feature.txt'), 'x\n');
+      svc.updateTask(t.id, {
+        executor_config: JSON.stringify({
+          mode: 'acceptEdits',
+          repo: 'repo',
+          base_commit: svc.getTask(t.id).executor_config ? JSON.parse(svc.getTask(t.id).executor_config).base_commit : null,
+          commit: true,
+          commit_paths: ['feature.txt', 'other.txt'],
+          verify_profile_id: svc.getTask(t.id).verify_profile_id
+        })
+      });
+      return { ok: true, exitCode: 0, text: 'done', isolated: true, network: 'fake-net', image: 'fake-image', raw: '' };
+    }
+  };
+  const r = await svc.runTask(t.id, { isolation: driftIso });
+  assert.equal(r.ok, false);
+  assert.equal(r.commit?.skipped, true);
+  assert.match(r.commit?.reason ?? '', /参数|审批/);
+  assert.equal(headOf(repo), before, '参数漂移后不得产生新 commit');
+  assert.equal(svc.getTask(t.id).status, 'failed');
+});
+
+test('PRE-A01 审批在执行期间被撤销必须拒绝提交', async () => {
+  const { t, repo } = approvedTask('a01-revoke');
+  const before = headOf(repo);
+  const revokeIso = {
+    ...fakeIsolation,
+    runClaudeIsolated: async ({ workdir }) => {
+      writeFileSync(join(workdir, 'feature.txt'), 'x\n');
+      svc.db().prepare('UPDATE approvals SET revoked_at=? WHERE task_id=?').run(new Date().toISOString(), t.id);
+      return { ok: true, exitCode: 0, text: 'done', isolated: true, network: 'fake-net', image: 'fake-image', raw: '' };
+    }
+  };
+  const r = await svc.runTask(t.id, { isolation: revokeIso });
+  assert.equal(r.ok, false);
+  assert.equal(r.commit?.skipped, true);
+  assert.match(r.commit?.reason ?? '', /审批|Execution/);
+  assert.equal(headOf(repo), before, '撤销审批后不得产生新 commit');
+  assert.equal(svc.getTask(t.id).status, 'failed');
+});
+
+test('PRE-A01 已消耗审批不得被新执行复用', async () => {
+  const { t, repo } = approvedTask('a01-reuse');
+  const before = headOf(repo);
+  const first = await svc.runTask(t.id, { isolation: fakeIsolation });
+  assert.equal(first.ok, true, JSON.stringify(first));
+  const approval = svc.db().prepare('SELECT * FROM approvals WHERE task_id=?').get(t.id);
+  assert.equal(svc.findValidApproval(t.id, approval.digest).valid, false);
+
+  // 模拟重试入口：任务回到 retry_pending，但旧审批仍归第一次执行所有
+  svc.updateTask(t.id, { status: 'retry_pending' });
+  const again = await svc.runTask(t.id, { isolation: fakeIsolation });
+  assert.equal(again.ok, false);
+  assert.equal(again.blocked, 'needs_approval');
+  const runningAfter = svc.db().prepare("SELECT COUNT(*) AS n FROM executions WHERE task_id=? AND status='running'").get(t.id).n;
+  assert.equal(runningAfter, 0, '旧审批不得启动新的执行');
+  assert.equal(headOf(repo), before, '重试不得改变仓库 HEAD');
+  const refSha = execFileSync('git', ['-C', repo, 'rev-parse', `refs/heads/jarvis/${t.id}`], { encoding: 'utf8' }).trim();
+  assert.equal(refSha, first.commit.sha, '第一次执行的 Ref 仍应指向真实 Commit');
+});
+
+/* -------------------------- 取消 / 提交竞态 ---------------------------- */
+
+test('取消在提交前成立：不得开始 Git Commit', async () => {
+  const { t, repo } = approvedTask('cancel-before');
+  const before = headOf(repo);
+  let releaseRun;
+  let markStarted;
+  const started = new Promise((r) => { markStarted = r; });
+  const hold = new Promise((r) => { releaseRun = r; });
+  const gatedIso = {
+    ...fakeIsolation,
+    runClaudeIsolated: async ({ workdir }) => {
+      writeFileSync(join(workdir, 'feature.txt'), 'x\n');
+      markStarted();
+      await hold;
+      return { ok: true, exitCode: 0, text: 'done', isolated: true, network: 'fake-net', image: 'fake-image', raw: '' };
+    }
+  };
+  let commitCalled = false;
+  const spyExecutor = {
+    ...ex,
+    gitCommit: async (args) => { commitCalled = true; return ex.gitCommit(args); }
+  };
+  const running = svc.runTask(t.id, { isolation: gatedIso, executor: spyExecutor });
+  await started;
+  const cancelled = await svc.cancelTask(t.id, { isolation: gatedIso });
+  assert.equal(cancelled.ok, true, JSON.stringify(cancelled));
+  releaseRun();
+  const r = await running;
+  assert.equal(r.ok, false);
+  assert.equal(r.blocked, 'cancelled');
+  assert.equal(commitCalled, false, '取消成立后不得调用 gitCommit');
+  assert.equal(headOf(repo), before, '取消后仓库 HEAD 不得变化');
+  assert.equal(svc.getTask(t.id).status, 'cancelled');
+  const tokenFile = join(process.env.JARVIS_HOME, 'proxy', 'active-tokens.json');
+  assert.deepEqual(JSON.parse(readFileSync(tokenFile, 'utf8')), {}, '取消后模型令牌必须撤销');
+});
+
+test('提交中取消：不得立即虚报 cancelled，提交完成后必须记录真实 Commit/Ref', async () => {
+  const { t } = approvedTask('cancel-during');
+  let releaseCommit;
+  let markCommitStarted;
+  const commitStarted = new Promise((r) => { markCommitStarted = r; });
+  const commitHold = new Promise((r) => { releaseCommit = r; });
+  const spyExecutor = {
+    ...ex,
+    gitCommit: async (args) => {
+      markCommitStarted();
+      await commitHold;
+      return ex.gitCommit(args);
+    }
+  };
+  const running = svc.runTask(t.id, { isolation: fakeIsolation, executor: spyExecutor });
+  await commitStarted;
+  assert.equal(svc.getTask(t.id).status, 'committing');
+
+  const cancelled = await svc.cancelTask(t.id, { isolation: fakeIsolation });
+  assert.equal(cancelled.ok, false);
+  assert.equal(cancelled.blocked, 'commit_in_progress');
+  assert.equal(svc.getTask(t.id).status, 'committing', '提交中取消不得改写为 cancelled');
+
+  releaseCommit();
+  const r = await running;
+  assert.equal(r.ok, true, JSON.stringify({ verdict: r.verdict, commit: r.commit }));
+  assert.ok(r.commit?.sha);
+  assert.equal(r.commit.refVerified, true);
+  assert.equal(svc.getTask(t.id).status, 'done');
+  const after = await svc.cancelTask(t.id, { isolation: fakeIsolation });
+  assert.equal(after.ok, false, '提交完成后不能再虚报取消');
+  assert.equal(svc.getTask(t.id).status, 'done');
+});
+
+test('提交子进程异常：留下未确认状态，不虚报成功', async () => {
+  const { t, repo } = approvedTask('commit-crash');
+  const before = headOf(repo);
+  const crashExecutor = {
+    ...ex,
+    gitCommit: async () => { throw new Error('simulated git commit crash'); }
+  };
+  await assert.rejects(
+    () => svc.runTask(t.id, { isolation: fakeIsolation, executor: crashExecutor }),
+    /simulated git commit crash/
+  );
+  assert.equal(headOf(repo), before, '异常时不得产生无法解释的提交');
+  assert.equal(svc.getTask(t.id).status, 'committing', '异常后必须是未确认状态');
+  const execRow = svc.db().prepare("SELECT * FROM executions WHERE task_id=? AND status='running'").get(t.id);
+  assert.ok(execRow, '执行记录应保持 running，等待人工核查');
+});
+
+
+test('执行容器凭据文件不包含原始 GLM Key', async () => {
+  const { t } = approvedTask('cred-file');
+  let captured = null;
+  const iso = {
+    ...fakeIsolation,
+    runClaudeIsolated: async ({ workdir, credentialsFile }) => {
+      captured = { credentialsFile, body: readFileSync(credentialsFile, 'utf8') };
+      writeFileSync(join(workdir, 'feature.txt'), 'x\n');
+      return { ok: true, exitCode: 0, text: 'done', isolated: true, network: 'fake-net', image: 'fake-image', raw: '' };
+    }
+  };
+  const old = process.env.GLM_API_KEY;
+  process.env.GLM_API_KEY = 'sk-raw-secret-should-not-appear';
+  try {
+    const r = await svc.runTask(t.id, { isolation: iso });
+    assert.equal(r.ok, true, JSON.stringify(r));
+  } finally {
+    if (old === undefined) delete process.env.GLM_API_KEY;
+    else process.env.GLM_API_KEY = old;
+  }
+  assert.ok(captured?.credentialsFile, '必须生成容器凭据文件');
+  assert.ok(!captured.body.includes('sk-raw-secret-should-not-appear'), '原始 GLM Key 不得进入容器凭据');
+  assert.match(captured.body, /proxy-managed-placeholder/);
+  assert.match(captured.body, /\/api\/anthropic\/s\//);
+});
+
+
+/* -------------------- AC-13 / AC-14：Commit 门禁 ---------------------- */
+
+test('AC-13 校验失败不得产生 Commit', async () => {
+  const { t, repo } = approvedTask('ac13');
+  const before = headOf(repo);
+  const failVerifyIso = {
+    ...fakeIsolation,
+    runInWorkdir: async () => ({ ok: false, exitCode: 1, output: 'TEST_FAILED' })
+  };
+  const r = await svc.runTask(t.id, { isolation: failVerifyIso });
+  assert.equal(r.ok, false);
+  assert.equal(r.commit?.skipped, true);
+  assert.match(r.commit?.reason ?? '', /校验失败/);
+  assert.equal(r.verify?.exitCode, 1);
+  assert.equal(headOf(repo), before, '校验失败不得产生新 commit');
+  assert.equal(svc.getTask(t.id).status, 'failed');
+});
+
+test('AC-14 缺少可信校验不得产生 Commit', async () => {
+  const { p, head } = projectWithRepo('ac14');
+  const t = seedTask({ project: p, head, verifyProfileId: null });
+  const challenge = svc.createAuthChallenge(t.id);
+  const issued = svc.issueApproval({ task: t.id, proof: signChallenge(challenge) });
+  assert.equal(issued.ok, true, issued.error);
+  const repo = join(p.dir, 'repo');
+  const before = headOf(repo);
+  const r = await svc.runTask(t.id, { isolation: fakeIsolation });
+  assert.equal(r.ok, false);
+  assert.equal(r.commit?.skipped, true);
+  assert.match(r.commit?.reason ?? '', /缺少必需校验/);
+  assert.equal(headOf(repo), before, '缺少校验不得产生新 commit');
+  assert.equal(svc.getTask(t.id).status, 'failed');
+});
