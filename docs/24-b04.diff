+    eventsRaw: events.map(raw).join('\n'),
+    startedAt: BASE,
+    barrierAt: BASE + 100,
+    cancelRequestedAt: BASE + 200,
+    releaseAt: BASE + 300,
+    cancelResolvedAt: BASE + 800,
+    finalStateAt: BASE + 900,
